{
  "name": "@sudobility/music_lib",
  "version": "1.9.80",
  "description": "Platform-free business logic for ScoreSmith: domain services, generation, persistence rules, and preferences",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && vite build",
    "clean": "rimraf dist",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "verify": "bun run format:check && bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run clean && bun run verify",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts"
  },
  "files": [
    "dist/**/*",
    "CLAUDE.md"
  ],
  "keywords": [
    "music",
    "scoresmith",
    "notation",
    "midi",
    "musicxml",
    "vexflow",
    "tone"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/music_types": "^0.13.57",
    "immer": "^10.0.0 || ^11.0.0",
    "zustand": ">=5"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@sudobility/music_types": "^0.13.57",
    "@types/jsdom": "~30.0.0",
    "@types/node": "~26.6.5",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "ajv": "~8.20.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "fake-indexeddb": "~6.2.6",
    "globals": "~16.5.0",
    "immer": "~11.2.9",
    "jsdom": "~29.1.1",
    "prettier": "~3.9.10",
    "rimraf": "~6.1.3",
    "typescript": "~5.9.3",
    "vite": "~7.3.7",
    "vite-plugin-dts": "~4.5.4",
    "vitest": "~4.1.12",
    "zustand": "~5.0.16"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/music_lib.git"
  }
}
